# All services below are expected to run as locally installed
# (non-Docker) services. See README.md "Local Services Setup" for
# install instructions per OS.

# PostgreSQL (local install, default port 5432)
DB_URL=jdbc:postgresql://localhost:5432/codejudgex
DB_USER=codejudgex
DB_PASS=secret

# Redis (local install, default port 6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ (local install, default ports 5672 / 15672 management UI)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Judge0 CE (local install — see README.md for setup without Docker)
JUDGE0_URL=http://localhost:2358
JUDGE0_TOKEN=

# JWT
JWT_SECRET=change-me-in-production-use-256-bit-key
