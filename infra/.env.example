# Copy to infra/.env for docker-compose, or to backend/.env for native (mvnw) runs.
#
# docker-compose (infra/docker-compose.yml) wires DB/Redis/RabbitMQ/Judge0 to
# their container hostnames automatically — the values below are only used
# for JUDGE0_TOKEN, JWT_SECRET, and mail overrides when running via Docker.
#
# For native (non-Docker) runs, all variables below apply directly via
# application.yml env var defaults (localhost-based).

# PostgreSQL (native default port 5432; docker-compose maps the same port)
DB_URL=jdbc:postgresql://localhost:5432/codejudgex
DB_USER=codejudgex
DB_PASS=secret

# Redis (native default port 6379; docker-compose maps the same port)
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ (native default ports 5672 / 15672 management UI)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Judge0 CE
# - docker-compose: runs locally as judge0-server/judge0-workers, reachable
#   at http://localhost:2358 from the host, or http://judge0-server:2358
#   from other containers (already wired in docker-compose.yml)
# - native: point at a remote/hosted Judge0 instance (e.g. Judge0 RapidAPI)
JUDGE0_URL=http://localhost:2358
JUDGE0_TOKEN=

# JWT
JWT_SECRET=change-me-in-production-use-256-bit-key

# Mail (dev SMTP debug server, e.g. MailHog — included in docker-compose)
MAIL_HOST=localhost
MAIL_PORT=1025
